# 复制本文件为仓库根目录的 .env 后按需填写。不要把填好的 .env 提交进 Git。
# 本项目没有登录：端口对谁开放，谁就能改你的图谱。API_HOST 保持 127.0.0.1，不要把未鉴权端口映射到公网。
# 本项目没有 MySQL / Redis / SECRET_KEY：图存在 Kuzu 文件里，向量在 LanceDB 目录里，工作台状态在 JSON 里。

# ---------- 运行环境 ----------
# Docker Compose 一键启动：复制本文件为 .env 后执行 docker compose up -d --build
# Compose 会覆盖 API_HOST / 容器内端口 / 数据路径；下面的 API_PORT、WEB_PORT 只表示「映射到宿主机的端口」。
# 容器里 Next 固定把 /v1 转到 http://api:8000，不要把 API_INTERNAL_URL 写成公网地址。
# 容器访问宿主机上的兼容网关时，才需要把 LLM_BASE_URL 写成 http://host.docker.internal:<端口>/v1
# dev | prod。prod 时 API 默认关闭热重载（Compose 固定 prod）。
LYNOTE_ENV=dev

# API 监听地址。本机开发用 127.0.0.1；若必须让局域网访问可改 0.0.0.0，生产仍建议只绑回环 + 反向代理。
API_HOST=127.0.0.1
API_PORT=8000
# 兼容旧名：LYNOTE_API_HOST / LYNOTE_API_PORT 同样有效。

# 不设则：LYNOTE_ENV=prod 时关闭热重载，其余开启。Windows 下热重载常被 WatchFiles 打断，可取消下一行注释。
# API_RELOAD=0

# Next 把浏览器的 /v1/* 转到这个地址。必须是「Next 进程能连上的回环地址」。
# 即使 API 监听 0.0.0.0，这里也写 http://127.0.0.1:<API_PORT>，不要写公网 IP 或域名。
API_INTERNAL_URL=http://127.0.0.1:8000

# 前端对外 Origin。改端口或上域名时必改，并同步 CORS_ORIGINS。
WEB_ORIGIN=http://localhost:3000
# next dev / next start 的主机和端口（改这里不会自动改 npm 脚本，启动命令需自行加 -H / -p）。
WEB_HOST=127.0.0.1
WEB_PORT=3000

# 逗号分隔。直连 API 文档/跨域时用；经 Next 反代 /v1 时浏览器不撞 CORS。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 时间一律按 UTC 存盘。无需数据库时区。
# TZ=UTC

# ---------- LLM（默认官方 OpenAI）----------
# 复制本文件为 .env 后，把 LLM_API_KEY 换成 https://platform.openai.com 的密钥即可。
# Key 为空时闸门/抽取/简报走本地启发式，能跑通但不适合当真用。
# 协议是 OpenAI 兼容：Azure / vLLM / 其他 /v1 网关只需改 LLM_BASE_URL，官方地址不用动。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT=90
# 官方 OpenAI 不要设 caller。仅当兼容网关要求计费/审计字段时再取消注释。
# LLM_CALLER=

# ---------- Embeddings ----------
# 留空则复用上面的 LLM_API_KEY 和 LLM_BASE_URL（官方 OpenAI 同一把 Key 即可）。
# 两者都空则用本地 hashing 占位，不是生产质量。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIM=1536
# EMBEDDING_CALLER=

# ---------- 向量 ----------
# lancedb（默认，重启后 embedding 还在）或 memory（pytest 会强制 memory）
VECTOR_BACKEND=lancedb
VECTOR_PATH=data/vectors

RETRIEVE_TOP_K=8
RETRIEVE_MIN_SCORE=0.12

# ---------- 图谱与工作台落盘 ----------
# kuzu（默认）或 memory（pytest 会强制 memory，不碰 data/）
GRAPH_BACKEND=kuzu
GRAPH_PATH=data/lynote.kuzu
WORKSPACE_STATE_PATH=data/workspace.json

# ---------- 入库限制 ----------
INGEST_FETCH_TIMEOUT=20
INGEST_FETCH_MAX_BYTES=5242880
INGEST_UPLOAD_MAX_BYTES=33554432
INGEST_USER_AGENT=LyNote/0.1 (personal knowledge ingest)

# ---------- 行业检索（可选，只辅助归类）----------
# 默认 off：挂点只用图上已有概念/主题。
# 设为 http 后，抽取待挂时会搜几条公开网页，用来对照已有节点，不会写成主张，也不会建行业本体。
# 兼容常见 JSON：results[] / web.results[]，字段 title、url、snippet|content|description。
# SEARCH_BACKEND=http
# SEARCH_BASE_URL=https://example.com/search
# SEARCH_API_KEY=
# SEARCH_METHOD=POST
# SEARCH_TIMEOUT=8
